// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Define your database models here and run `prisma db push` to apply them to the database.

enum active_status {
  Online
  Offline
}

model User {
  id Int @id  @default(autoincrement())
  fullname String
  username String @unique
  email String @unique
  password String
  email_verified Boolean @default(false)
  profile_picture String?
  bio String? @default("No Bio Yet")
  active active_status @default(Online)
  following Follow[] @relation("following")
  followers Follow[] @relation("followers")
  posts Post[]
  saved Save[]
  likes Like[]
  comments Comment[]
  replies Reply[]
  comment_replies_likes CmtOrReplyLike[]
  is_admin Boolean @default(false)
  reset_code_hash String?
  reset_code_expiry DateTime?
  email_verification_hash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

}

enum status {
  Public
  Private
}

model Post {
  id Int @id  @default(autoincrement())
  caption String?
  content_url String?
  creator User @relation(fields: [creator_id], references: [id])
  creator_id Int
  likes Like[]
  comments Comment[]
  saves Save[]
  visibility status @default(Public)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  
}

model Save {
  id Int @id  @default(autoincrement())
  saver_id Int 
  post_id Int
  saver User @relation(fields: [saver_id],references: [id])
  post Post @relation(fields: [post_id],references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@unique([saver_id,post_id])
}

model Follow {
  id Int @id  @default(autoincrement())
  following_id Int
  follower_id Int
  following User @relation("following",fields: [following_id],references: [id])
  follower User @relation("followers",fields: [follower_id],references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@unique([follower_id, following_id])
}


model Like{
  id Int @id  @default(autoincrement())
  liked_id Int
  liker_id Int
  liked Post @relation(fields: [liked_id],references: [id])
  liker User @relation(fields: [liker_id],references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@unique([liker_id,liked_id])

}


model Comment {
  id Int @id  @default(autoincrement())
  comment String
  likes CmtOrReplyLike[]
  commented_id Int
  commenter_id Int
  commented Post @relation(fields: [commented_id],references: [id])
  commenter User @relation(fields: [commenter_id],references: [id])
  replies Reply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}


model Reply {
  id Int @id @default(autoincrement())
  reply String
  replied_id Int
  replier_id Int
  replied Comment @relation(fields: [replied_id], references: [id])
  replier User @relation(fields: [replier_id], references: [id])
  likes CmtOrReplyLike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

enum typeof_like {
  Comment
  Reply
}

model CmtOrReplyLike {
  id Int @id @default(autoincrement())
  like_type typeof_like
  liker_id Int
  comment_id Int?
  reply_id Int?
  liker User @relation(fields: [liker_id],references: [id])
  comment Comment? @relation(fields: [comment_id],references: [id])
  reply Reply? @relation(fields: [reply_id], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  @@unique([liker_id,comment_id])
  @@unique([liker_id,reply_id])
}